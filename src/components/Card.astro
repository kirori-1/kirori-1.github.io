---
export interface Props {
  title: string;
  link: string;
  desc: string;
}
const { title, link, desc } = Astro.props;
---

<!-- src/components/Card.astro -->
<a
  href={link}
  class="block p-6 bg-white dark:bg-zinc-900 border border-gray-200 dark:border-zinc-700 rounded-2xl shadow hover:shadow-lg transition"
>
  <h3 class="text-xl font-semibold mb-2">{title}</h3>
  <p class="text-gray-600 dark:text-gray-400">{desc}</p>
</a>

---
