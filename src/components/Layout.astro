---
const { children } = Astro.props;
---

<!-- src/layouts/Layout.astro -->
<html lang="zh">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Wang Jiaqi / Kirori</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-white dark:bg-zinc-950 text-black dark:text-white font-sans">
    <main>{children}</main>
    <footer class="text-center text-sm text-gray-500 py-8">
      © {new Date().getFullYear()} Kirori · All rights reserved.
    </footer>
  </body>
</html>
