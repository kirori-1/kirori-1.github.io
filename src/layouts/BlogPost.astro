---
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";

type Props = CollectionEntry<"blog">["data"];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;

// 默认图片
const defaultHeroImage = "/blog-placeholder-1.jpg";
---

<html lang="zh-CN">
  <head>
    <BaseHead title={title} description={description} />
    <link
      href="https://fonts.googleapis.com/css2?family=Zen+Maru+Gothic:wght@400;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body
    class="font-sans bg-gradient-to-br from-zinc-50 via-blue-50 to-purple-50 dark:from-zinc-950 dark:via-zinc-900 dark:to-zinc-800 min-h-screen"
  >
    <Header />

    <main>
      <!-- 返回按钮 -->
      <div class="max-w-4xl mx-auto px-4 pt-6">
        <a href="/blog" class="back-button">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M19 12H5M12 19l-7-7 7-7"></path>
          </svg>
          返回博客列表
        </a>
      </div>

      <article class="blog-article">
        <!-- 文章头部 -->
        <div class="article-header">
          <div class="hero-image">
            <img
              src={heroImage || defaultHeroImage}
              alt={title}
              class="w-full h-full object-cover"
            />
            <div class="overlay"></div>
          </div>

          <div class="title-container">
            <div class="date-info">
              <span class="publish-date">
                <FormattedDate date={pubDate} />
              </span>
              {
                updatedDate && (
                  <span class="update-date">
                    最后更新: <FormattedDate date={updatedDate} />
                  </span>
                )
              }
            </div>
            <h1>{title}</h1>
            {description && <p class="description">{description}</p>}
          </div>
        </div>

        <!-- 文章内容 -->
        <div class="prose">
          <slot />
        </div>

        <!-- 文章底部 -->
        <div class="article-footer">
          <div class="tags">
            <span class="tag">音响技术</span>
            <span class="tag">教程</span>
          </div>

          <div class="share-buttons">
            <button class="share-button">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path
                  d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"
                ></path>
              </svg>
              分享
            </button>
            <button class="share-button">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path
                  d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"
                ></path>
              </svg>
              推文
            </button>
          </div>
        </div>
      </article>

      <!-- 相关文章 -->
      <div class="related-posts">
        <h3>相关文章</h3>
        <div class="related-grid">
          <a href="#" class="related-card">
            <img src="/blog-placeholder-2.jpg" alt="相关文章" />
            <div class="related-content">
              <h4>音响系统结构设计基础</h4>
              <p>了解如何设计专业的音响系统结构...</p>
            </div>
          </a>
          <a href="#" class="related-card">
            <img src="/blog-placeholder-3.jpg" alt="相关文章" />
            <div class="related-content">
              <h4>混音技巧与实践</h4>
              <p>专业混音师分享的实用技巧...</p>
            </div>
          </a>
        </div>
      </div>
    </main>

    <Footer />

    <!-- 返回顶部按钮 -->
    <button id="back-to-top" class="back-to-top" aria-label="返回顶部">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M18 15l-6-6-6 6"></path>
      </svg>
    </button>

    <script>
      // 返回顶部按钮
      const backToTopButton = document.getElementById("back-to-top");

      if (backToTopButton) {
        // 初始隐藏
        backToTopButton.style.display = "none";

        // 监听滚动
        window.addEventListener("scroll", () => {
          if (window.scrollY > 300) {
            backToTopButton.style.display = "flex";
          } else {
            backToTopButton.style.display = "none";
          }
        });

        // 点击返回顶部
        backToTopButton.addEventListener("click", () => {
          window.scrollTo({
            top: 0,
            behavior: "smooth",
          });
        });
      }
    </script>
  </body>
</html>

<style>
  /* 主要布局 */
  main {
    width: 100%;
    max-width: 100%;
    margin: 0 auto;
    padding-bottom: 4rem;
  }

  .blog-article {
    background-color: white;
    border-radius: 1rem;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
    margin: 1rem auto 3rem;
    max-width: 900px;
  }

  /* 文章头部 */
  .article-header {
    position: relative;
  }

  .hero-image {
    position: relative;
    width: 100%;
    height: 400px;
    overflow: hidden;
  }

  .overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 50%;
    background: linear-gradient(to bottom, transparent, rgba(0, 0, 0, 0.7));
  }

  .title-container {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    padding: 2rem;
    color: white;
    z-index: 2;
  }

  .title-container h1 {
    font-size: 2.5rem;
    margin: 0.5rem 0;
    line-height: 1.2;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
  }

  .date-info {
    display: flex;
    gap: 1rem;
    font-size: 0.9rem;
    opacity: 0.9;
  }

  .update-date {
    font-style: italic;
  }

  .description {
    max-width: 800px;
    margin-top: 0.5rem;
    font-size: 1.1rem;
    opacity: 0.9;
  }

  /* 文章内容 */
  .prose {
    padding: 2rem;
    color: #333;
    font-size: 1.1rem;
    line-height: 1.8;
  }

  .prose h1,
  .prose h2,
  .prose h3,
  .prose h4 {
    margin-top: 2rem;
    margin-bottom: 1rem;
    color: #222;
  }

  .prose p {
    margin-bottom: 1.5rem;
  }

  .prose img {
    max-width: 100%;
    border-radius: 0.5rem;
    margin: 1.5rem 0;
  }

  .prose table {
    width: 100%;
    border-collapse: collapse;
    margin: 2rem 0;
    overflow: hidden;
    border-radius: 0.5rem;
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.05);
  }

  .prose th,
  .prose td {
    padding: 0.75rem 1rem;
    border: 1px solid #eee;
  }

  .prose th {
    background-color: #f8f9fa;
    font-weight: 600;
  }

  .prose tr:nth-child(even) {
    background-color: #f8f9fa;
  }

  /* 代码块样式 */
  .prose pre {
    background-color: #1e1e1e;
    color: #e6e6e6;
    padding: 1.5rem;
    border-radius: 0.5rem;
    overflow-x: auto;
    margin: 1.5rem 0;
  }

  .prose code {
    font-family: "Fira Code", monospace;
    font-size: 0.9rem;
  }

  /* 文章底部 */
  .article-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem 2rem;
    border-top: 1px solid #eee;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .tags {
    display: flex;
    gap: 0.5rem;
  }

  .tag {
    background-color: #f0f0f0;
    color: #666;
    padding: 0.3rem 0.8rem;
    border-radius: 2rem;
    font-size: 0.8rem;
    transition: all 0.2s;
  }

  .tag:hover {
    background-color: var(--accent);
    color: white;
  }

  .share-buttons {
    display: flex;
    gap: 0.5rem;
  }

  .share-button {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background-color: #f0f0f0;
    color: #666;
    padding: 0.5rem 1rem;
    border-radius: 2rem;
    font-size: 0.9rem;
    border: none;
    cursor: pointer;
    transition: all 0.2s;
  }

  .share-button:hover {
    background-color: var(--accent);
    color: white;
  }

  /* 相关文章 */
  .related-posts {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  .related-posts h3 {
    font-size: 1.5rem;
    margin-bottom: 1.5rem;
    color: #333;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .related-card {
    background-color: white;
    border-radius: 0.75rem;
    overflow: hidden;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
    transition:
      transform 0.3s,
      box-shadow 0.3s;
    text-decoration: none;
    color: inherit;
  }

  .related-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.15);
  }

  .related-card img {
    width: 100%;
    height: 160px;
    object-fit: cover;
  }

  .related-content {
    padding: 1rem;
  }

  .related-content h4 {
    font-size: 1.1rem;
    margin: 0 0 0.5rem;
    color: #333;
  }

  .related-content p {
    font-size: 0.9rem;
    color: #666;
    margin: 0;
  }

  /* 返回按钮 */
  .back-button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #666;
    font-size: 0.9rem;
    padding: 0.5rem 1rem;
    border-radius: 2rem;
    background-color: white;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    transition: all 0.2s;
    text-decoration: none;
    margin-bottom: 1rem;
  }

  .back-button:hover {
    background-color: var(--accent);
    color: white;
  }

  /* 返回顶部按钮 */
  .back-to-top {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background-color: var(--accent);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    border: none;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
    transition: all 0.2s;
    z-index: 100;
  }

  .back-to-top:hover {
    transform: translateY(-5px);
    box-shadow: 0 6px 15px rgba(0, 0, 0, 0.25);
  }

  /* 响应式调整 */
  @media (max-width: 768px) {
    .hero-image {
      height: 300px;
    }

    .title-container h1 {
      font-size: 2rem;
    }

    .prose {
      padding: 1.5rem;
      font-size: 1rem;
    }

    .article-footer {
      flex-direction: column;
      align-items: flex-start;
    }

    .back-to-top {
      bottom: 1.5rem;
      right: 1.5rem;
      width: 2.5rem;
      height: 2.5rem;
    }
  }

  @media (max-width: 480px) {
    .hero-image {
      height: 250px;
    }

    .title-container {
      padding: 1.5rem;
    }

    .title-container h1 {
      font-size: 1.75rem;
    }

    .date-info {
      flex-direction: column;
      gap: 0.25rem;
    }
  }
</style>
