---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="About Kirori" description="Learn more about Kirori." />
    <style>
      body {
        margin: 0;
        padding: 0;
        font-family: "Arial", sans-serif;
        background: #f4f4f4;
      }
      main {
        max-width: 800px;
        margin: 0 auto;
        padding: 20px;
        text-align: center;
      }
      .threejs-container {
        width: 100%;
        height: 400px;
        position: relative;
        margin-bottom: 20px;
      }
      canvas {
        display: block;
      }
      /* 导航栏样式 */
      nav {
        display: flex;
        gap: 20px;
        margin-bottom: 20px;
      }
      nav a {
        text-decoration: none;
        color: #333;
        font-weight: bold;
      }
      nav a:hover {
        color: #007bff;
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <h1>👋 こんにちは、Kiroriです！</h1>
      <p>
        私は東京を拠点に活動するプログラマーであり、音楽クリエイターです。
        このページでは、私の経歴やスキル、興味について紹介します。
      </p>
      <div class="threejs-container">
        <canvas
          id="threejs-canvas"
          class="w-full max-w-3xl h-[400px] mx-auto block"></canvas>
      </div>
      <p>
        プログラミングと音楽制作の両方に情熱を持ち、技術とアートの融合を追求しています。
        特に、Web開発と音響技術に興味があり、新しいプロジェクトに常に挑戦しています。
      </p>
    </main>
    <Footer />
    <script>
      import * as THREE from "three";
      // Three.js 动画
      const canvas = document.getElementById("threejs-canvas");
      if (!(canvas instanceof HTMLCanvasElement)) {
        console.error("No threejs-canvas found");
      } else {
        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(
          75,
          canvas.clientWidth / canvas.clientHeight,
          0.1,
          1000
        );
        const renderer = new THREE.WebGLRenderer({ canvas, antialias: true });
        renderer.setSize(canvas.clientWidth, canvas.clientHeight);

        // 添加一个立方体
        const geometry2 = new THREE.SphereGeometry(100, 100, 100);
        const geometry = new THREE.BoxGeometry();
        const material = new THREE.MeshBasicMaterial({
          color: 0x80ffff,
          wireframe: false,
        });
        const cube = new THREE.Mesh(geometry, material);
        const cube2 = new THREE.Mesh(geometry2, material);
        scene.add(cube,cube2);

        camera.position.z = 3;

        // 动画循环
        const animate = () => {
          requestAnimationFrame(animate);
          cube.rotation.x += 0.01;
          cube.rotation.y += 0.01;
          renderer.render(scene, camera);
        };
        animate();

        // 窗口大小调整时更新渲染器
        window.addEventListener("resize", () => {
          const width = canvas.clientWidth;
          const height = canvas.clientHeight;
          renderer.setSize(width, height);
          camera.aspect = width / height;
          camera.updateProjectionMatrix();
        });
      }
    </script>
  </body>
</html>
