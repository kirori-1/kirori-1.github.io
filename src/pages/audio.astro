---
import Layout from "../components/Layout.astro";
import { getCollection } from "astro:content";
import { categories, getCategoryById } from "../config/categories";

// 获取音响技术相关的博客文章
const allPosts = await getCollection("blog");
const audioCategory = getCategoryById("audio");
const audioPosts = allPosts
  .filter((post) => {
    const postTags = (post.data as any).tags || [];
    return postTags.some((tag: string) => audioCategory?.tags.includes(tag));
  })
  .sort(
    (a, b) =>
      new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
  )
  .slice(0, 6);
---

<Layout
  title="音响技术"
  description="舞台音响、录音工程与音频技术笔记"
  image="/logo.png"
>
  <!-- Hero Section -->
  <section
    class="relative py-20 bg-gradient-to-br from-blue-50 via-indigo-50 to-purple-50 dark:from-blue-950 dark:via-indigo-900 dark:to-purple-900"
  >
    <div
      class="absolute inset-0 bg-gradient-to-r from-blue-600/10 via-indigo-600/10 to-purple-600/10"
    >
    </div>
    <div class="relative max-w-4xl mx-auto px-6 text-center">
      <div
        class="inline-flex items-center justify-center w-20 h-20 bg-gradient-to-r from-blue-500 to-indigo-600 rounded-2xl mb-6 shadow-lg"
      >
        <span class="text-3xl">🎵</span>
      </div>
      <h1
        class="text-5xl font-bold mb-6 bg-gradient-to-r from-blue-900 via-indigo-600 to-purple-600 dark:from-blue-100 dark:via-indigo-400 dark:to-purple-400 bg-clip-text text-transparent"
      >
        音响技术
      </h1>
      <p
        class="text-xl text-gray-600 dark:text-gray-400 max-w-3xl mx-auto leading-relaxed"
      >
        探索声音的奥秘，从舞台音响到录音工程，记录音频技术的实践与思考。
      </p>
      <div
        class="w-24 h-1 bg-gradient-to-r from-blue-500 to-indigo-500 mx-auto rounded-full mt-6"
      >
      </div>
    </div>
  </section>

  <!-- Audio Technology Overview -->
  <section class="py-16 bg-white dark:bg-zinc-900">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold mb-4 text-gray-900 dark:text-white">
          技术领域
        </h2>
        <p class="text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
          从基础理论到实践应用，全面掌握音频工程的核心技术。
        </p>
      </div>

      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        <div
          class="group bg-gradient-to-br from-blue-50 to-indigo-50 dark:from-blue-900/20 dark:to-indigo-900/20 p-8 rounded-2xl border border-blue-100 dark:border-blue-800 hover:shadow-xl transition-all duration-300"
        >
          <div class="text-4xl mb-4">🎤</div>
          <h3 class="text-xl font-bold mb-3 text-gray-900 dark:text-white">
            话筒技术
          </h3>
          <p class="text-gray-600 dark:text-gray-400">
            各种话筒类型的选择与使用，现场拾音技巧与话筒摆放原理。
          </p>
        </div>

        <div
          class="group bg-gradient-to-br from-indigo-50 to-purple-50 dark:from-indigo-900/20 dark:to-purple-900/20 p-8 rounded-2xl border border-indigo-100 dark:border-indigo-800 hover:shadow-xl transition-all duration-300"
        >
          <div class="text-4xl mb-4">🔊</div>
          <h3 class="text-xl font-bold mb-3 text-gray-900 dark:text-white">
            音响系统
          </h3>
          <p class="text-gray-600 dark:text-gray-400">
            音响系统的设计与配置，信号流程与设备连接原理。
          </p>
        </div>

        <div
          class="group bg-gradient-to-br from-purple-50 to-pink-50 dark:from-purple-900/20 dark:to-pink-900/20 p-8 rounded-2xl border border-purple-100 dark:border-purple-800 hover:shadow-xl transition-all duration-300"
        >
          <div class="text-4xl mb-4">🎛️</div>
          <h3 class="text-xl font-bold mb-3 text-gray-900 dark:text-white">
            调音技术
          </h3>
          <p class="text-gray-600 dark:text-gray-400">
            现场调音技巧，EQ调节、压缩器使用与混音技术。
          </p>
        </div>

        <div
          class="group bg-gradient-to-br from-pink-50 to-red-50 dark:from-pink-900/20 dark:to-red-900/20 p-8 rounded-2xl border border-pink-100 dark:border-pink-800 hover:shadow-xl transition-all duration-300"
        >
          <div class="text-4xl mb-4">🎧</div>
          <h3 class="text-xl font-bold mb-3 text-gray-900 dark:text-white">
            录音工程
          </h3>
          <p class="text-gray-600 dark:text-gray-400">
            录音棚技术，多轨录音、后期处理与母带制作。
          </p>
        </div>

        <div
          class="group bg-gradient-to-br from-red-50 to-orange-50 dark:from-red-900/20 dark:to-orange-900/20 p-8 rounded-2xl border border-red-100 dark:border-red-800 hover:shadow-xl transition-all duration-300"
        >
          <div class="text-4xl mb-4">📐</div>
          <h3 class="text-xl font-bold mb-3 text-gray-900 dark:text-white">
            声学原理
          </h3>
          <p class="text-gray-600 dark:text-gray-400">
            声学基础理论，声音传播、反射与吸收原理。
          </p>
        </div>

        <div
          class="group bg-gradient-to-br from-orange-50 to-yellow-50 dark:from-orange-900/20 dark:to-yellow-900/20 p-8 rounded-2xl border border-orange-100 dark:border-orange-800 hover:shadow-xl transition-all duration-300"
        >
          <div class="text-4xl mb-4">🎪</div>
          <h3 class="text-xl font-bold mb-3 text-gray-900 dark:text-white">
            现场音响
          </h3>
          <p class="text-gray-600 dark:text-gray-400">
            舞台音响配置，现场演出音响设计与故障排除。
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Related Blog Posts -->
  {
    audioPosts.length > 0 && (
      <section class="py-16 bg-gradient-to-br from-zinc-50 to-blue-50 dark:from-zinc-900 dark:to-zinc-800">
        <div class="max-w-6xl mx-auto px-6">
          <div class="text-center mb-12">
            <h2 class="text-3xl font-bold mb-4 bg-gradient-to-r from-blue-900 via-indigo-600 to-purple-600 dark:from-blue-100 dark:via-indigo-400 dark:to-purple-400 bg-clip-text text-transparent">
              相关文章
            </h2>
            <p class="text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
              探索音响技术相关的博客文章，深入了解音频工程的专业知识。
            </p>
            <div class="w-24 h-1 bg-gradient-to-r from-blue-500 to-indigo-500 mx-auto rounded-full mt-4" />
          </div>

          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {audioPosts.map((post) => (
              <article class="group bg-white dark:bg-zinc-800 rounded-2xl shadow-lg hover:shadow-2xl transition-all duration-300 overflow-hidden border border-gray-100 dark:border-zinc-700">
                <div class="h-48 bg-gradient-to-br from-blue-400 to-indigo-500 relative overflow-hidden">
                  <div class="absolute inset-0 bg-black bg-opacity-20" />
                  <div class="absolute bottom-4 left-4 text-white">
                    <span class="text-sm opacity-90">
                      {new Date(post.data.pubDate).toLocaleDateString("zh-CN")}
                    </span>
                  </div>
                </div>
                <div class="p-6">
                  <h3 class="text-xl font-bold mb-3 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors line-clamp-2">
                    {post.data.title}
                  </h3>
                  {post.data.description && (
                    <p class="text-gray-600 dark:text-gray-400 text-sm line-clamp-3 mb-4">
                      {post.data.description}
                    </p>
                  )}
                  <a
                    href={`/blog/${post.id}`}
                    class="inline-flex items-center text-blue-600 dark:text-blue-400 font-medium hover:text-blue-800 dark:hover:text-blue-300 transition-colors"
                  >
                    阅读文章
                    <svg
                      class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M13 7l5 5m0 0l-5 5m5-5H6"
                      />
                    </svg>
                  </a>
                </div>
              </article>
            ))}
          </div>

          <div class="text-center mt-8">
            <a
              href="/blog?category=audio"
              class="inline-flex items-center px-8 py-4 bg-gradient-to-r from-blue-600 to-indigo-600 text-white rounded-2xl hover:from-blue-700 hover:to-indigo-700 transition-all duration-300 shadow-lg hover:shadow-xl"
            >
              查看更多音响技术文章
              <svg
                class="w-5 h-5 ml-2"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 7l5 5m0 0l-5 5m5-5H6"
                />
              </svg>
            </a>
          </div>
        </div>
      </section>
    )
  }

  <!-- Audio Quote -->
  <section class="py-16 bg-gradient-to-r from-blue-600 to-indigo-600">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <blockquote
        class="text-2xl md:text-3xl font-medium text-white leading-relaxed mb-6"
      >
        "声音是情感的载体，技术是表达的工具。"
      </blockquote>
      <p class="text-blue-100 text-lg">— 音频工程感悟</p>
    </div>
  </section>
</Layout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
