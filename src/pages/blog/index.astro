---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../../consts";
import { getCollection } from "astro:content";
import FormattedDate from "../../components/FormattedDate.astro";
import { categories, getCategoryById } from "../../config/categories";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// 获取URL参数
const url = new URL(Astro.request.url);
const selectedCategory = url.searchParams.get("category") || "all";
const selectedTag = url.searchParams.get("tag");

// 获取文章摘要
function getExcerpt(content: string, maxLength = 150) {
  if (!content) return "";
  const excerpt = content.slice(0, maxLength);
  return excerpt.length < content.length ? `${excerpt}...` : excerpt;
}

// 默认图片列表，用于没有特色图片的文章
const placeholderImages = [
  "/blog-placeholder-1.jpg",
  "/blog-placeholder-2.jpg",
  "/blog-placeholder-3.jpg",
  "/blog-placeholder-4.jpg",
  "/blog-placeholder-5.jpg",
];

// 过滤文章
let filteredPosts = posts;

// 按分类过滤
if (selectedCategory !== "all") {
  const category = getCategoryById(selectedCategory);
  if (category) {
    filteredPosts = posts.filter((post) => {
      const postTags = (post.data as any).tags || [];
      return postTags.some((tag: string) => category.tags.includes(tag));
    });
  }
}

// 按标签过滤
if (selectedTag) {
  filteredPosts = filteredPosts.filter((post) => {
    const postTags = (post.data as any).tags || [];
    return postTags.includes(selectedTag);
  });
}

// 为每篇文章分配一个图片
const postsWithImages = filteredPosts.map((post, index) => {
  const imageIndex = index % placeholderImages.length;
  return {
    ...post,
    image: post.data.heroImage || placeholderImages[imageIndex],
  };
});

// 获取所有标签用于显示
const allTags = new Set<string>();
posts.forEach((post) => {
  const postTags = (post.data as any).tags || [];
  postTags.forEach((tag: string) => allTags.add(tag));
});
const sortedTags = Array.from(allTags).sort();

// 计算每个分类的文章数量
const categoryStats = categories
  .map((category) => {
    const count = posts.filter((post) => {
      const postTags = (post.data as any).tags || [];
      return postTags.some((tag: string) => category.tags.includes(tag));
    }).length;
    return {
      ...category,
      count,
    };
  })
  .filter((cat) => cat.count > 0);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <link
      href="https://fonts.googleapis.com/css2?family=Zen+Maru+Gothic:wght@400;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body
    class="font-sans bg-gradient-to-br from-zinc-50 via-blue-50 to-purple-50 dark:from-zinc-950 dark:via-zinc-900 dark:to-zinc-800 min-h-screen"
  >
    <Header />
    <main class="max-w-4xl mx-auto px-4 sm:px-6 py-8">
      <div class="text-center mb-16">
        <div
          class="inline-flex items-center justify-center w-20 h-20 bg-gradient-to-r from-blue-500 to-purple-600 rounded-2xl mb-6 shadow-lg"
        >
          <span class="text-3xl">📚</span>
        </div>
        <h1
          class="text-5xl font-bold mb-6 bg-gradient-to-r from-zinc-900 via-blue-600 to-purple-600 dark:from-white dark:via-blue-400 dark:to-purple-400 bg-clip-text text-transparent"
        >
          博客
        </h1>
        <p
          class="max-w-3xl mx-auto text-xl text-gray-600 dark:text-gray-400 leading-relaxed"
        >
          探索音响技术、编程和音乐创作的世界。这里记录了我的学习笔记、项目经验和专业见解。
        </p>

        <!-- Enhanced wave decoration -->
        <div class="wave-decoration my-8 h-16 overflow-hidden relative">
          <div class="wave absolute w-full h-full"></div>
        </div>
      </div>

      <!-- Category Navigation -->
      <div class="flex justify-center mb-12 flex-wrap gap-3">
        {
          categories.map((category) => (
            <a
              href={`/blog?category=${category.id}`}
              class={`category-pill ${selectedCategory === category.id ? "active" : ""}`}
            >
              <span class="mr-2">{category.icon}</span>
              {category.name}
            </a>
          ))
        }
      </div>

      <!-- Category Statistics -->
      <div class="text-center mb-8">
        <h3 class="text-lg font-semibold mb-4 text-gray-700 dark:text-gray-300">
          分类统计
        </h3>
        <div
          class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 max-w-4xl mx-auto"
        >
          {
            categoryStats.map((category) => (
              <div class="bg-white dark:bg-zinc-800 rounded-lg p-4 shadow-md hover:shadow-lg transition-shadow">
                <div class="text-2xl mb-2">{category.icon}</div>
                <div class="text-sm font-medium text-gray-900 dark:text-white mb-1">
                  {category.name}
                </div>
                <div class="text-xs text-gray-500 dark:text-gray-400">
                  {category.count} 篇文章
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Category Pages Navigation -->
      <div class="text-center mb-8">
        <h3 class="text-lg font-semibold mb-4 text-gray-700 dark:text-gray-300">
          分类页面
        </h3>
        <div class="flex flex-wrap justify-center gap-3">
          <a href="/philosophy" class="category-page-link">
            <span class="mr-2">🤔</span>
            哲学学习
          </a>
          <a href="/scriptwriting" class="category-page-link">
            <span class="mr-2">📝</span>
            剧本创作
          </a>
          <a href="/audio" class="category-page-link">
            <span class="mr-2">🎵</span>
            音响技术
          </a>
          <a href="/programming" class="category-page-link">
            <span class="mr-2">💻</span>
            编程开发
          </a>
          <a href="/wordpress" class="category-page-link">
            <span class="mr-2">🌐</span>
            WordPress
          </a>
          <a href="/tools" class="category-page-link">
            <span class="mr-2">📚</span>
            工具文档
          </a>
        </div>
      </div>

      <!-- Tag Filter -->
      {
        selectedTag && (
          <div class="text-center mb-8">
            <div class="inline-flex items-center gap-2 bg-blue-100 dark:bg-blue-900/20 px-4 py-2 rounded-full">
              <span class="text-sm text-blue-600 dark:text-blue-400">
                当前标签:
              </span>
              <span class="font-medium text-blue-800 dark:text-blue-200">
                {selectedTag}
              </span>
              <a
                href={`/blog?category=${selectedCategory}`}
                class="text-blue-500 hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-200 ml-2"
              >
                ✕
              </a>
            </div>
          </div>
        )
      }

      <!-- Tags Cloud -->
      <div class="text-center mb-8">
        <h3 class="text-lg font-semibold mb-4 text-gray-700 dark:text-gray-300">
          标签云
        </h3>
        <div class="flex flex-wrap justify-center gap-2">
          {
            sortedTags.map((tag) => (
              <a
                href={`/blog?category=${selectedCategory}&tag=${encodeURIComponent(tag)}`}
                class={`tag-pill ${selectedTag === tag ? "active" : ""}`}
              >
                {tag}
              </a>
            ))
          }
        </div>
      </div>

      <!-- 博客文章卡片网格 -->
      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {
          postsWithImages.map((post) => (
            <a href={`/blog/${post.id}/`} class="blog-card group">
              <div class="blog-card-image">
                <img src={post.image} alt={post.data.title} />
              </div>
              <div class="blog-card-content">
                <p class="text-sm text-accent mb-2">
                  <FormattedDate date={post.data.pubDate} />
                </p>
                <h2 class="text-xl font-bold text-primary group-hover:text-accent transition-colors">
                  {post.data.title}
                </h2>
                {post.data.description && (
                  <p class="mt-2 text-sm line-clamp-2">
                    {post.data.description}
                  </p>
                )}
                {(post.data as any).tags &&
                  (post.data as any).tags.length > 0 && (
                    <div class="mt-3 flex flex-wrap gap-1">
                      {(post.data as any).tags
                        .slice(0, 3)
                        .map((tag: string) => (
                          <span class="inline-block px-2 py-1 text-xs bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 rounded-full">
                            {tag}
                          </span>
                        ))}
                      {(post.data as any).tags.length > 3 && (
                        <span class="inline-block px-2 py-1 text-xs bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 rounded-full">
                          +{(post.data as any).tags.length - 3}
                        </span>
                      )}
                    </div>
                  )}
              </div>
            </a>
          ))
        }
      </div>
    </main>
    <Footer />
  </body>
</html>

<style>
  /* 博客卡片样式 */
  .blog-card {
    @apply bg-white rounded-xl shadow-md overflow-hidden transition-all hover:shadow-lg hover:scale-[1.02];
    display: flex;
    flex-direction: column;
  }

  .blog-card-image {
    @apply relative overflow-hidden h-48;
  }

  .blog-card-image img {
    @apply w-full h-full object-cover transition-transform duration-500;
  }

  .blog-card:hover .blog-card-image img {
    @apply scale-110;
  }

  .blog-card-content {
    @apply p-5 flex-1 flex flex-col;
  }

  .category-pill {
    @apply px-6 py-3 rounded-full text-sm font-medium transition-all duration-300;
    @apply bg-white dark:bg-zinc-800 text-gray-700 dark:text-gray-300;
    @apply border border-gray-200 dark:border-zinc-700;
    @apply hover:bg-blue-50 dark:hover:bg-blue-900/20 hover:border-blue-300 dark:hover:border-blue-600;
    @apply hover:scale-105 hover:shadow-md;
    text-decoration: none;
  }

  .category-pill.active {
    @apply bg-gradient-to-r from-blue-600 to-purple-600 text-white border-transparent shadow-lg;
  }

  .tag-pill {
    @apply px-3 py-1 rounded-full text-xs font-medium transition-all duration-200;
    @apply bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-300;
    @apply hover:bg-blue-100 dark:hover:bg-blue-900/20 hover:text-blue-600 dark:hover:text-blue-400;
    text-decoration: none;
  }

  .tag-pill.active {
    @apply bg-blue-600 text-white hover:bg-blue-700;
  }

  .category-page-link {
    @apply px-4 py-2 rounded-lg text-sm font-medium transition-all duration-300;
    @apply bg-gradient-to-r from-gray-100 to-gray-200 dark:from-gray-700 dark:to-gray-600;
    @apply text-gray-700 dark:text-gray-300;
    @apply hover:from-indigo-100 hover:to-purple-100 dark:hover:from-indigo-800 dark:hover:to-purple-800;
    @apply hover:text-indigo-700 dark:hover:text-indigo-300;
    @apply hover:scale-105 hover:shadow-md;
    text-decoration: none;
  }

  /* 波浪动画 */
  .wave {
    background: linear-gradient(to right, #ff9a9e, #fad0c4);
    height: 100%;
    width: 200%;
    animation: wave 8s linear infinite;
    mask-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 1200 120' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M0 0v46.29c47.79 22.2 103.59 32.17 158 28 70.36-5.37 136.33-33.31 206.8-37.5 73.84-4.36 147.54 16.88 218.2 35.26 69.27 18.17 138.3 24.88 209.4 13.08 36.15-6 69.85-17.84 104.45-29.34C989.49 25 1113-14.29 1200 52.47V0z' opacity='.25'/%3E%3Cpath d='M0 0v15.81c13 21.11 27.64 41.05 47.69 56.24C99.41 111.27 165 111 224.58 91.58c31.15-10.15 60.09-26.07 89.67-39.8 40.92-19 84.73-46 130.83-49.67 36.26-2.85 70.9 9.42 98.6 31.56 31.77 25.39 62.32 62 103.63 73 40.44 10.79 81.35-6.69 119.13-24.28s75.16-39 116.92-43.05c59.73-5.85 113.28 22.88 168.9 38.84 30.2 8.66 59 6.17 87.09-7.5 22.43-10.89 48-26.93 60.65-49.24V0z' opacity='.5'/%3E%3Cpath d='M0 0v5.63C149.93 59 314.09 71.32 475.83 42.57c43-7.64 84.23-20.12 127.61-26.46 59-8.63 112.48 12.24 165.56 35.4C827.93 77.22 886 95.24 951.2 90c86.53-7 172.46-45.71 248.8-84.81V0z'/%3E%3C/svg%3E");
    mask-size: cover;
    mask-repeat: no-repeat;
  }

  @keyframes wave {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  /* 文本截断 */
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
