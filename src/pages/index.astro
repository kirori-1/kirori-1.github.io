---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import HeroWave from "../components/HeroWave.astro";
import Layout from "../components/Layout.astro";
import Card from "../components/Card.astro";
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .slice(0, 3);
---

<Layout title="主页面" description="这是主页" image="/logo.png">
  <!-- Hero Section -->
  <HeroWave />
  <div class="relative z-10 flex flex-col justify-center items-center h-[480px] text-center px-4 -mt-16">
    <img
      src="/profile.jpg"
      alt="Profile"
      class="w-52 h-52 object-cover rounded-full border-4 border-white dark:border-zinc-900 mt-16"
    />
    <h1 class="text-5xl font-bold mt-6 text-zinc-900 dark:text-white">
      Wang Jiaqi / Kirori
    </h1>
    <p class="mt-2 text-xl text-gray-600 dark:text-gray-400">
      思辨者 • 声音工程师 • 软件开发者<br />
      Operating between Tokyo & Hebei
    </p>
    <div class="mt-6">
      <a
        href="/about"
        class="inline-block px-5 py-3 bg-zinc-900 text-white rounded-2xl shadow hover:shadow-lg transition"
      >
        了解更多
      </a>
    </div>
  </div>

  <!-- Projects or Works Section -->
  <section class="max-w-6xl mx-auto px-6">
    <h2
      class="text-2xl font-semibold mb-6 border-b pb-2 text-zinc-800 dark:text-white"
    >
      精选项目 / Works
    </h2>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <Card
        title="哲学笔记"
        link="/philosophy"
        desc="以思辨方式书写日常与反思。"
      />
      <Card
        title="声音工程记录"
        link="/sound"
        desc="舞台音响与录音协助项目笔记。"
      />
      <Card
        title="开发项目"
        link="/projects"
        desc="个人开发作品，涉及音频、前端、AI 辅助等。"
      />
    </div>
  </section>

  <!-- Optional Blog Preview -->
  <section class="max-w-6xl mx-auto mt-16 px-6">
    <h2
      class="text-2xl font-semibold mb-6 border-b pb-2 text-zinc-800 dark:text-white"
    >
      最新文章 / Blog
    </h2>
    <p class="text-gray-500 dark:text-gray-400">
      （可选）接入 Markdown 博客系统后展示近期文章。
    </p>
    <ul>
      {sortedPosts.map((post) => (
        <li class="my-2">
          <a
            href={"/blog/" + post.id}
            class="text-blue-500 underline hover:text-blue-700 transition-colors duration-300"
          >
            {post.data.title}
          </a>
          <span class="text-sm text-gray-400 ml-2">
            {post.data.pubDate}
          </span>
        </li>
      ))}
    </ul>
  </section>

  <!-- Canvas Section -->
  <section class="flex justify-center mt-12">
    <canvas
      id="defaultCanvas0"
      class="p5Canvas"
      style="width: 100%; height: auto; background: transparent"
      width="2484"
      height="960"></canvas>
  </section>

  <!-- Links Section -->
  <section class="grid gap-6 sm:grid-cols-2 md:grid-cols-3 mt-12 px-6">
    <a href="/projects" class="link-card"> 🧑‍💻 技術プロジェクト </a>
    <a href="/music" class="link-card"> 🎸 音楽作品 </a>
    <a href="/studio" class="link-card"> 🎧 録音と調律 </a>
    <a href="/blog" class="link-card"> 📚 ブログ </a>
    <a href="/contact" class="link-card"> 📬 連絡先 </a>
  </section>

  <!-- Weather Section -->
  <section class="text-center mt-10 text-sm text-gray-500 dark:text-gray-400">
    <div id="weather">Tokyo の天気情報を取得中…</div>
  </section>
</Layout>

<!-- Weather Script -->
<script lang="ts">
  const weatherEl = document.getElementById("weather");
  fetch(
    `https://api.openweathermap.org/data/2.5/weather?q=Tokyo&appid=c73e40879c12ab0f31c98fc6253a5ec4&units=metric`
  )
    .then((res) => res.json())
    .then((data) => {
      if (weatherEl) {
        weatherEl.innerText = `東京の現在気温: ${data.main.temp}°C`;
      }
    })
    .catch(() => {
      if (weatherEl) {
        weatherEl.innerText = "天気情報の取得に失敗しました。";
      }
    });
</script>

<style>
  .link-card {
    @apply bg-white dark:bg-zinc-900 p-6 rounded-xl shadow-md hover:shadow-lg text-center transition-all;
    font-size: 1.1rem;
    font-weight: 500;
    text-decoration: none;
    color: theme("colors.zinc.800");
  }

  .link-card:hover {
    @apply bg-zinc-100 dark:bg-zinc-800 scale-105;
  }

  body {
    @apply min-h-screen bg-zinc-100 dark:bg-zinc-950 text-zinc-900 dark:text-zinc-100 font-sans;
  }

  #defaultCanvas0 {
    display: block;
    margin: 0 auto;
  }
</style>
