---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import HeroWave from "../components/HeroWave.astro";
import Layout from "../components/Layout.astro";
import Card from "../components/Card.astro";
import { getCollection } from "astro:content";

const allPosts = await getCollection("blog");
const sortedPosts = allPosts
  .sort(
    (a, b) =>
      new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
  )
  .slice(0, 3);
---

<Layout title="主页面" description="这是主页" image="/logo.png">
  <!-- Hero Section -->
  <HeroWave />
  <div
    class="relative z-10 flex flex-col justify-center items-center h-[480px] text-center px-4 -mt-16"
  >
    <!-- Profile Image with enhanced styling -->
    <div class="relative group">
      <div
        class="absolute inset-0 bg-gradient-to-r from-blue-400 via-purple-500 to-pink-500 rounded-full blur-lg opacity-75 group-hover:opacity-100 transition duration-1000"
      >
      </div>
      <img
        src="/profile.jpg"
        alt="Profile"
        class="relative w-52 h-52 object-cover rounded-full border-4 border-white dark:border-zinc-900 mt-16 shadow-2xl group-hover:scale-105 transition-transform duration-500"
      />
    </div>

    <!-- Enhanced Typography -->
    <div class="space-y-4 mt-8">
      <h1
        class="text-5xl font-bold bg-gradient-to-r from-zinc-900 via-blue-600 to-purple-600 dark:from-white dark:via-blue-400 dark:to-purple-400 bg-clip-text text-transparent animate-fade-in-up"
      >
        Wang Jiaqi / Kirori
      </h1>
      <div
        class="text-xl text-gray-600 dark:text-gray-400 space-y-2 animate-fade-in-up"
        style="animation-delay: 0.2s"
      >
        <p class="flex items-center justify-center gap-2">
          <span class="w-2 h-2 bg-blue-500 rounded-full animate-pulse"></span>
          思辨者 • 声音工程师 • 软件开发者
        </p>
        <p class="text-lg opacity-80">Operating between Tokyo & Hebei</p>
      </div>
    </div>

    <!-- Enhanced CTA Buttons -->
    <div
      class="mt-8 flex flex-col sm:flex-row gap-4 animate-fade-in-up"
      style="animation-delay: 0.4s"
    >
      <a
        href="/about"
        class="group relative px-8 py-4 bg-gradient-to-r from-zinc-900 to-zinc-700 text-white rounded-2xl shadow-lg hover:shadow-2xl transition-all duration-300 overflow-hidden"
      >
        <span class="relative z-10 flex items-center gap-2">
          了解更多
          <svg
            class="w-4 h-4 group-hover:translate-x-1 transition-transform"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
          </svg>
        </span>
        <div
          class="absolute inset-0 bg-gradient-to-r from-blue-600 to-purple-600 opacity-0 group-hover:opacity-100 transition-opacity duration-300"
        >
        </div>
      </a>
      <a
        href="/contact"
        class="px-8 py-4 border-2 border-zinc-900 dark:border-white text-zinc-900 dark:text-white rounded-2xl hover:bg-zinc-900 dark:hover:bg-white hover:text-white dark:hover:text-zinc-900 transition-all duration-300"
      >
        联系我
      </a>
    </div>
  </div>

  <!-- Projects or Works Section -->
  <section class="max-w-6xl mx-auto px-6 py-16">
    <div class="text-center mb-12">
      <h2
        class="text-4xl font-bold mb-4 bg-gradient-to-r from-zinc-900 via-blue-600 to-purple-600 dark:from-white dark:via-blue-400 dark:to-purple-400 bg-clip-text text-transparent"
      >
        精选项目 / Works
      </h2>
      <div
        class="w-24 h-1 bg-gradient-to-r from-blue-500 to-purple-500 mx-auto rounded-full"
      >
      </div>
    </div>
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      <div class="group">
        <Card
          title="哲学笔记"
          link="/philosophy"
          desc="以思辨方式书写日常与反思。"
          icon="🤔"
        />
      </div>
      <div class="group">
        <Card
          title="声音工程记录"
          link="/sound"
          desc="舞台音响与录音协助项目笔记。"
          icon="🎵"
        />
      </div>
      <div class="group">
        <Card
          title="开发项目"
          link="/projects"
          desc="个人开发作品，涉及音频、前端、AI 辅助等。"
          icon="💻"
        />
      </div>
    </div>
  </section>

  <!-- Latest Blog Posts Section -->
  <section
    class="max-w-6xl mx-auto px-6 py-16 bg-gradient-to-br from-zinc-50 to-blue-50 dark:from-zinc-900 dark:to-zinc-800 rounded-3xl mx-4"
  >
    <div class="text-center mb-12">
      <h2
        class="text-4xl font-bold mb-4 bg-gradient-to-r from-zinc-900 via-blue-600 to-purple-600 dark:from-white dark:via-blue-400 dark:to-purple-400 bg-clip-text text-transparent"
      >
        最新文章 / Blog
      </h2>
      <p class="text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
        探索音响技术、编程和音乐创作的世界。这里记录了我的学习笔记、项目经验和专业见解。
      </p>
      <div
        class="w-24 h-1 bg-gradient-to-r from-blue-500 to-purple-500 mx-auto rounded-full mt-4"
      >
      </div>
    </div>

    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        sortedPosts.map((post, index) => (
          <article class="group bg-white dark:bg-zinc-800 rounded-2xl shadow-lg hover:shadow-2xl transition-all duration-300 overflow-hidden border border-gray-100 dark:border-zinc-700">
            <div class="h-48 bg-gradient-to-br from-blue-400 to-purple-500 relative overflow-hidden">
              <div class="absolute inset-0 bg-black bg-opacity-20" />
              <div class="absolute bottom-4 left-4 text-white">
                <span class="text-sm opacity-90">
                  {new Date(post.data.pubDate).toLocaleDateString("zh-CN")}
                </span>
              </div>
            </div>
            <div class="p-6">
              <h3 class="text-xl font-bold mb-3 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors line-clamp-2">
                {post.data.title}
              </h3>
              {post.data.description && (
                <p class="text-gray-600 dark:text-gray-400 text-sm line-clamp-3 mb-4">
                  {post.data.description}
                </p>
              )}
              <a
                href={"/blog/" + post.id}
                class="inline-flex items-center text-blue-600 dark:text-blue-400 font-medium hover:text-blue-800 dark:hover:text-blue-300 transition-colors"
              >
                阅读更多
                <svg
                  class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M13 7l5 5m0 0l-5 5m5-5H6"
                  />
                </svg>
              </a>
            </div>
          </article>
        ))
      }
    </div>

    <div class="text-center mt-8">
      <a
        href="/blog"
        class="inline-flex items-center px-8 py-4 bg-gradient-to-r from-blue-600 to-purple-600 text-white rounded-2xl hover:from-blue-700 hover:to-purple-700 transition-all duration-300 shadow-lg hover:shadow-xl"
      >
        查看所有文章
        <svg
          class="w-5 h-5 ml-2"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
        </svg>
      </a>
    </div>
  </section>

  <!-- Canvas Section -->
  <section class="flex justify-center mt-12">
    <canvas
      id="defaultCanvas0"
      class="p5Canvas"
      style="width: 100%; height: auto; background: transparent"
      width="2484"
      height="960"></canvas>
  </section>

  <!-- Quick Links Section -->
  <section class="max-w-6xl mx-auto px-6 py-16">
    <div class="text-center mb-12">
      <h2
        class="text-3xl font-bold mb-4 bg-gradient-to-r from-zinc-900 via-blue-600 to-purple-600 dark:from-white dark:via-blue-400 dark:to-purple-400 bg-clip-text text-transparent"
      >
        快速导航 / Quick Links
      </h2>
      <div
        class="w-24 h-1 bg-gradient-to-r from-blue-500 to-purple-500 mx-auto rounded-full"
      >
      </div>
    </div>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-5">
      <a href="/projects" class="quick-link-card group">
        <div class="quick-link-icon">🧑‍💻</div>
        <div class="quick-link-content">
          <h3>技术项目</h3>
          <p>技術プロジェクト</p>
        </div>
      </a>
      <a href="/music" class="quick-link-card group">
        <div class="quick-link-icon">🎸</div>
        <div class="quick-link-content">
          <h3>音乐作品</h3>
          <p>音楽作品</p>
        </div>
      </a>
      <a href="/studio" class="quick-link-card group">
        <div class="quick-link-icon">🎧</div>
        <div class="quick-link-content">
          <h3>录音调律</h3>
          <p>録音と調律</p>
        </div>
      </a>
      <a href="/blog" class="quick-link-card group">
        <div class="quick-link-icon">📚</div>
        <div class="quick-link-content">
          <h3>博客</h3>
          <p>ブログ</p>
        </div>
      </a>
      <a href="/contact" class="quick-link-card group">
        <div class="quick-link-icon">📬</div>
        <div class="quick-link-content">
          <h3>联系方式</h3>
          <p>連絡先</p>
        </div>
      </a>
    </div>
  </section>

  <!-- Weather Section -->
  <section class="text-center mt-10 text-sm text-gray-500 dark:text-gray-400">
    <div id="weather">Tokyo の天気情報を取得中…</div>
  </section>
</Layout>

<!-- Weather Script -->
<script lang="ts">
  const weatherEl = document.getElementById("weather");
  fetch(
    `https://api.openweathermap.org/data/2.5/weather?q=Tokyo&appid=c73e40879c12ab0f31c98fc6253a5ec4&units=metric`
  )
    .then((res) => res.json())
    .then((data) => {
      if (weatherEl) {
        weatherEl.innerText = `東京の現在気温: ${data.main.temp}°C`;
      }
    })
    .catch(() => {
      if (weatherEl) {
        weatherEl.innerText = "天気情報の取得に失敗しました。";
      }
    });
</script>

<style>
  /* Quick Link Cards */
  .quick-link-card {
    @apply bg-white dark:bg-zinc-900 p-6 rounded-2xl shadow-lg hover:shadow-2xl text-center transition-all duration-300 overflow-hidden relative;
    text-decoration: none;
    color: theme("colors.zinc.800");
    border: 1px solid theme("colors.gray.200");
  }

  .quick-link-card:hover {
    @apply scale-105 border-blue-300 dark:border-blue-600;
    transform: translateY(-5px);
  }

  .quick-link-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(59, 130, 246, 0.1),
      transparent
    );
    transition: left 0.5s;
  }

  .quick-link-card:hover::before {
    left: 100%;
  }

  .quick-link-icon {
    @apply text-4xl mb-4 transition-transform duration-300;
  }

  .quick-link-card:hover .quick-link-icon {
    @apply scale-110;
  }

  .quick-link-content h3 {
    @apply text-lg font-bold mb-2 text-zinc-900 dark:text-white;
  }

  .quick-link-content p {
    @apply text-sm text-gray-600 dark:text-gray-400;
  }

  /* Text truncation */
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  body {
    @apply min-h-screen bg-gradient-to-br from-zinc-100 via-blue-50 to-purple-50 dark:from-zinc-950 dark:via-zinc-900 dark:to-zinc-800 text-zinc-900 dark:text-zinc-100 font-sans;
  }

  #defaultCanvas0 {
    display: block;
    margin: 0 auto;
    border-radius: 1rem;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
  }

  /* Enhanced animations */
  @keyframes fade-in-up {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in-up {
    animation: fade-in-up 0.8s ease-out both;
  }

  /* Responsive adjustments */
  @media (max-width: 768px) {
    .quick-link-card {
      @apply p-4;
    }

    .quick-link-icon {
      @apply text-3xl mb-3;
    }

    .quick-link-content h3 {
      @apply text-base;
    }
  }
</style>
