---
import Layout from "../components/Layout.astro";
import { getCollection } from "astro:content";
import { categories, getCategoryById } from "../config/categories";

// 获取哲学学习相关的博客文章
const allPosts = await getCollection("blog");
const philosophyCategory = getCategoryById("philosophy");
const philosophyPosts = allPosts
  .filter((post) => {
    const postTags = (post.data as any).tags || [];
    return postTags.some((tag: string) =>
      philosophyCategory?.tags.includes(tag)
    );
  })
  .sort(
    (a, b) =>
      new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
  )
  .slice(0, 6);
---

<Layout
  title="哲学学习"
  description="哲学思考、思辨文章与理论学习笔记"
  image="/logo.png"
>
  <!-- Hero Section -->
  <section
    class="relative py-20 bg-gradient-to-br from-indigo-50 via-purple-50 to-pink-50 dark:from-indigo-950 dark:via-purple-900 dark:to-pink-900"
  >
    <div
      class="absolute inset-0 bg-gradient-to-r from-indigo-600/10 via-purple-600/10 to-pink-600/10"
    >
    </div>
    <div class="relative max-w-4xl mx-auto px-6 text-center">
      <div
        class="inline-flex items-center justify-center w-20 h-20 bg-gradient-to-r from-indigo-500 to-purple-600 rounded-2xl mb-6 shadow-lg"
      >
        <span class="text-3xl">🤔</span>
      </div>
      <h1
        class="text-5xl font-bold mb-6 bg-gradient-to-r from-indigo-900 via-purple-600 to-pink-600 dark:from-indigo-100 dark:via-purple-400 dark:to-pink-400 bg-clip-text text-transparent"
      >
        哲学学习
      </h1>
      <p
        class="text-xl text-gray-600 dark:text-gray-400 max-w-3xl mx-auto leading-relaxed"
      >
        探索智慧的源泉，以思辨的方式理解世界。这里记录了我的哲学思考、理论学习与思辨实践。
      </p>
      <div
        class="w-24 h-1 bg-gradient-to-r from-indigo-500 to-purple-500 mx-auto rounded-full mt-6"
      >
      </div>
    </div>
  </section>

  <!-- Philosophy Overview -->
  <section class="py-16 bg-white dark:bg-zinc-900">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold mb-4 text-gray-900 dark:text-white">
          学习领域
        </h2>
        <p class="text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
          从古典哲学，现代思想，形而上学，伦理学，美学，政治哲学。
        </p>
      </div>

      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        <div
          class="group bg-gradient-to-br from-indigo-50 to-purple-50 dark:from-indigo-900/20 dark:to-purple-900/20 p-8 rounded-2xl border border-indigo-100 dark:border-indigo-800 hover:shadow-xl transition-all duration-300"
        >
          <div class="text-4xl mb-4">🏛️</div>
          <h3 class="text-xl font-bold mb-3 text-gray-900 dark:text-white">
            古典哲学
          </h3>
          <p class="text-gray-600 dark:text-gray-400">苏格拉底，亚里士多德。</p>
        </div>

        <div
          class="group bg-gradient-to-br from-purple-50 to-pink-50 dark:from-purple-900/20 dark:to-pink-900/20 p-8 rounded-2xl border border-purple-100 dark:border-purple-800 hover:shadow-xl transition-all duration-300"
        >
          <div class="text-4xl mb-4">🧠</div>
          <h3 class="text-xl font-bold mb-3 text-gray-900 dark:text-white">
            现代思想
          </h3>
          <p class="text-gray-600 dark:text-gray-400">
            从启蒙运动到存在主义，理解现代哲学对传统问题的重新审视。
          </p>
        </div>

        <div
          class="group bg-gradient-to-br from-pink-50 to-indigo-50 dark:from-pink-900/20 dark:to-indigo-900/20 p-8 rounded-2xl border border-pink-100 dark:border-pink-800 hover:shadow-xl transition-all duration-300"
        >
          <div class="text-4xl mb-4">⚖️</div>
          <h3 class="text-xl font-bold mb-3 text-gray-900 dark:text-white">
            伦理学
          </h3>
          <p class="text-gray-600 dark:text-gray-400">
            探讨道德判断的基础，思考善与恶、对与错的哲学根源。
          </p>
        </div>

        <div
          class="group bg-gradient-to-br from-blue-50 to-indigo-50 dark:from-blue-900/20 dark:to-indigo-900/20 p-8 rounded-2xl border border-blue-100 dark:border-blue-800 hover:shadow-xl transition-all duration-300"
        >
          <div class="text-4xl mb-4">🌌</div>
          <h3 class="text-xl font-bold mb-3 text-gray-900 dark:text-white">
            形而上学
          </h3>
          <p class="text-gray-600 dark:text-gray-400">
            追问存在的本质，探索现实、真理与知识的根本问题。
          </p>
        </div>

        <div
          class="group bg-gradient-to-br from-green-50 to-blue-50 dark:from-green-900/20 dark:to-blue-900/20 p-8 rounded-2xl border border-green-100 dark:border-green-800 hover:shadow-xl transition-all duration-300"
        >
          <div class="text-4xl mb-4">🎭</div>
          <h3 class="text-xl font-bold mb-3 text-gray-900 dark:text-white">
            美学
          </h3>
          <p class="text-gray-600 dark:text-gray-400">
            思考美的本质，探讨艺术、审美体验与创造力的哲学意义。
          </p>
        </div>

        <div
          class="group bg-gradient-to-br from-yellow-50 to-orange-50 dark:from-yellow-900/20 dark:to-orange-900/20 p-8 rounded-2xl border border-yellow-100 dark:border-yellow-800 hover:shadow-xl transition-all duration-300"
        >
          <div class="text-4xl mb-4">🤝</div>
          <h3 class="text-xl font-bold mb-3 text-gray-900 dark:text-white">
            政治哲学
          </h3>
          <p class="text-gray-600 dark:text-gray-400">
            探讨权力、正义与自由，思考理想社会的哲学基础。
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Related Blog Posts -->
  {
    philosophyPosts.length > 0 && (
      <section class="py-16 bg-gradient-to-br from-zinc-50 to-blue-50 dark:from-zinc-900 dark:to-zinc-800">
        <div class="max-w-6xl mx-auto px-6">
          <div class="text-center mb-12">
            <h2 class="text-3xl font-bold mb-4 bg-gradient-to-r from-indigo-900 via-purple-600 to-pink-600 dark:from-indigo-100 dark:via-purple-400 dark:to-pink-400 bg-clip-text text-transparent">
              相关文章
            </h2>
            <p class="text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
              探索哲学学习相关的博客文章，深入了解我的思辨历程。
            </p>
            <div class="w-24 h-1 bg-gradient-to-r from-indigo-500 to-purple-500 mx-auto rounded-full mt-4" />
          </div>

          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {philosophyPosts.map((post) => (
              <article class="group bg-white dark:bg-zinc-800 rounded-2xl shadow-lg hover:shadow-2xl transition-all duration-300 overflow-hidden border border-gray-100 dark:border-zinc-700">
                <div class="h-48 bg-gradient-to-br from-indigo-400 to-purple-500 relative overflow-hidden">
                  <div class="absolute inset-0 bg-black bg-opacity-20" />
                  <div class="absolute bottom-4 left-4 text-white">
                    <span class="text-sm opacity-90">
                      {new Date(post.data.pubDate).toLocaleDateString("zh-CN")}
                    </span>
                  </div>
                </div>
                <div class="p-6">
                  <h3 class="text-xl font-bold mb-3 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors line-clamp-2">
                    {post.data.title}
                  </h3>
                  {post.data.description && (
                    <p class="text-gray-600 dark:text-gray-400 text-sm line-clamp-3 mb-4">
                      {post.data.description}
                    </p>
                  )}
                  <a
                    href={`/blog/${post.id}`}
                    class="inline-flex items-center text-indigo-600 dark:text-indigo-400 font-medium hover:text-indigo-800 dark:hover:text-indigo-300 transition-colors"
                  >
                    阅读文章
                    <svg
                      class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M13 7l5 5m0 0l-5 5m5-5H6"
                      />
                    </svg>
                  </a>
                </div>
              </article>
            ))}
          </div>

          <div class="text-center mt-8">
            <a
              href="/blog?category=philosophy"
              class="inline-flex items-center px-8 py-4 bg-gradient-to-r from-indigo-600 to-purple-600 text-white rounded-2xl hover:from-indigo-700 hover:to-purple-700 transition-all duration-300 shadow-lg hover:shadow-xl"
            >
              查看更多哲学文章
              <svg
                class="w-5 h-5 ml-2"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 7l5 5m0 0l-5 5m5-5H6"
                />
              </svg>
            </a>
          </div>
        </div>
      </section>
    )
  }

  <!-- Philosophy Quote -->
  <section class="py-16 bg-gradient-to-r from-indigo-600 to-purple-600">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <blockquote
        class="text-2xl md:text-3xl font-medium text-white leading-relaxed mb-6"
      >
        "哲学不是给出答案，而是提出正确的问题。"
      </blockquote>
      <p class="text-indigo-100 text-lg">— 苏格拉底</p>
    </div>
  </section>
</Layout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
