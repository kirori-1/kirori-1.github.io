---
import Layout from "../components/Layout.astro";
import { getCollection } from "astro:content";
import { categories, getCategoryById } from "../config/categories";

// 获取编程开发相关的博客文章
const allPosts = await getCollection("blog");
const programmingCategory = getCategoryById("programming");
const programmingPosts = allPosts
  .filter((post) => {
    const postTags = (post.data as any).tags || [];
    return postTags.some((tag: string) =>
      programmingCategory?.tags.includes(tag)
    );
  })
  .sort(
    (a, b) =>
      new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
  )
  .slice(0, 6);
---

<Layout
  title="编程开发"
  description="前端开发、后端技术与工具使用经验"
  image="/logo.png"
>
  <!-- Hero Section -->
  <section
    class="relative py-20 bg-gradient-to-br from-green-50 via-blue-50 to-purple-50 dark:from-green-950 dark:via-blue-900 dark:to-purple-900"
  >
    <div
      class="absolute inset-0 bg-gradient-to-r from-green-600/10 via-blue-600/10 to-purple-600/10"
    >
    </div>
    <div class="relative max-w-4xl mx-auto px-6 text-center">
      <div
        class="inline-flex items-center justify-center w-20 h-20 bg-gradient-to-r from-green-500 to-blue-600 rounded-2xl mb-6 shadow-lg"
      >
        <span class="text-3xl">💻</span>
      </div>
      <h1
        class="text-5xl font-bold mb-6 bg-gradient-to-r from-green-900 via-blue-600 to-purple-600 dark:from-green-100 dark:via-blue-400 dark:to-purple-400 bg-clip-text text-transparent"
      >
        编程开发
      </h1>
      <p
        class="text-xl text-gray-600 dark:text-gray-400 max-w-3xl mx-auto leading-relaxed"
      >
        从代码到产品，探索编程的艺术与科学。记录我的开发经验、技术学习和项目实践。
      </p>
      <div
        class="w-24 h-1 bg-gradient-to-r from-green-500 to-blue-500 mx-auto rounded-full mt-6"
      >
      </div>
    </div>
  </section>

  <!-- Programming Overview -->
  <section class="py-16 bg-white dark:bg-zinc-900">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold mb-4 text-gray-900 dark:text-white">
          技术栈
        </h2>
        <p class="text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
          从前端到后端，从工具到架构，全面掌握现代软件开发技术。
        </p>
      </div>

      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        <div
          class="group bg-gradient-to-br from-green-50 to-blue-50 dark:from-green-900/20 dark:to-blue-900/20 p-8 rounded-2xl border border-green-100 dark:border-green-800 hover:shadow-xl transition-all duration-300"
        >
          <div class="text-4xl mb-4">⚛️</div>
          <h3 class="text-xl font-bold mb-3 text-gray-900 dark:text-white">
            React 生态
          </h3>
          <p class="text-gray-600 dark:text-gray-400">
            React、Next.js、状态管理等现代前端框架与工具的使用经验。
          </p>
        </div>

        <div
          class="group bg-gradient-to-br from-blue-50 to-indigo-50 dark:from-blue-900/20 dark:to-indigo-900/20 p-8 rounded-2xl border border-blue-100 dark:border-blue-800 hover:shadow-xl transition-all duration-300"
        >
          <div class="text-4xl mb-4">🔷</div>
          <h3 class="text-xl font-bold mb-3 text-gray-900 dark:text-white">
            TypeScript
          </h3>
          <p class="text-gray-600 dark:text-gray-400">
            TypeScript 类型系统、泛型编程与大型项目的类型安全实践。
          </p>
        </div>

        <div
          class="group bg-gradient-to-br from-indigo-50 to-purple-50 dark:from-indigo-900/20 dark:to-purple-900/20 p-8 rounded-2xl border border-indigo-100 dark:border-indigo-800 hover:shadow-xl transition-all duration-300"
        >
          <div class="text-4xl mb-4">🎨</div>
          <h3 class="text-xl font-bold mb-3 text-gray-900 dark:text-white">
            UI 框架
          </h3>
          <p class="text-gray-600 dark:text-gray-400">
            Chakra UI、Tailwind CSS 等现代 UI 框架的设计与实现技巧。
          </p>
        </div>

        <div
          class="group bg-gradient-to-br from-purple-50 to-pink-50 dark:from-purple-900/20 dark:to-pink-900/20 p-8 rounded-2xl border border-purple-100 dark:border-purple-800 hover:shadow-xl transition-all duration-300"
        >
          <div class="text-4xl mb-4">🏗️</div>
          <h3 class="text-xl font-bold mb-3 text-gray-900 dark:text-white">
            前端架构
          </h3>
          <p class="text-gray-600 dark:text-gray-400">
            组件设计、状态管理、模块化架构等前端工程化实践。
          </p>
        </div>

        <div
          class="group bg-gradient-to-br from-pink-50 to-red-50 dark:from-pink-900/20 dark:to-red-900/20 p-8 rounded-2xl border border-pink-100 dark:border-pink-800 hover:shadow-xl transition-all duration-300"
        >
          <div class="text-4xl mb-4">⚡</div>
          <h3 class="text-xl font-bold mb-3 text-gray-900 dark:text-white">
            构建工具
          </h3>
          <p class="text-gray-600 dark:text-gray-400">
            Vite、Webpack、ESBuild 等现代构建工具的配置与优化。
          </p>
        </div>

        <div
          class="group bg-gradient-to-br from-red-50 to-orange-50 dark:from-red-900/20 dark:to-orange-900/20 p-8 rounded-2xl border border-red-100 dark:border-red-800 hover:shadow-xl transition-all duration-300"
        >
          <div class="text-4xl mb-4">🔧</div>
          <h3 class="text-xl font-bold mb-3 text-gray-900 dark:text-white">
            开发工具
          </h3>
          <p class="text-gray-600 dark:text-gray-400">
            VS Code、Git、调试工具等开发环境配置与效率提升技巧。
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Development Process -->
  <section
    class="py-16 bg-gradient-to-br from-gray-50 to-green-50 dark:from-gray-900 dark:to-green-900"
  >
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold mb-4 text-gray-900 dark:text-white">
          开发流程
        </h2>
        <p class="text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
          从需求分析到产品上线，探索我的软件开发工作流程。
        </p>
      </div>

      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-4">
        <div class="text-center">
          <div
            class="w-16 h-16 bg-gradient-to-r from-green-500 to-blue-600 rounded-full flex items-center justify-center mx-auto mb-4"
          >
            <span class="text-white text-2xl">📋</span>
          </div>
          <h3 class="text-lg font-semibold mb-2 text-gray-900 dark:text-white">
            需求分析
          </h3>
          <p class="text-sm text-gray-600 dark:text-gray-400">
            理解业务需求，制定技术方案，设计系统架构。
          </p>
        </div>

        <div class="text-center">
          <div
            class="w-16 h-16 bg-gradient-to-r from-blue-500 to-indigo-600 rounded-full flex items-center justify-center mx-auto mb-4"
          >
            <span class="text-white text-2xl">🎨</span>
          </div>
          <h3 class="text-lg font-semibold mb-2 text-gray-900 dark:text-white">
            界面设计
          </h3>
          <p class="text-sm text-gray-600 dark:text-gray-400">
            设计用户界面，制定设计系统，确保用户体验。
          </p>
        </div>

        <div class="text-center">
          <div
            class="w-16 h-16 bg-gradient-to-r from-indigo-500 to-purple-600 rounded-full flex items-center justify-center mx-auto mb-4"
          >
            <span class="text-white text-2xl">⚙️</span>
          </div>
          <h3 class="text-lg font-semibold mb-2 text-gray-900 dark:text-white">
            编码实现
          </h3>
          <p class="text-sm text-gray-600 dark:text-gray-400">
            编写高质量代码，遵循最佳实践，注重代码可维护性。
          </p>
        </div>

        <div class="text-center">
          <div
            class="w-16 h-16 bg-gradient-to-r from-purple-500 to-pink-600 rounded-full flex items-center justify-center mx-auto mb-4"
          >
            <span class="text-white text-2xl">🚀</span>
          </div>
          <h3 class="text-lg font-semibold mb-2 text-gray-900 dark:text-white">
            测试部署
          </h3>
          <p class="text-sm text-gray-600 dark:text-gray-400">
            全面测试，持续集成，自动化部署，确保产品质量。
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Related Blog Posts -->
  {
    programmingPosts.length > 0 && (
      <section class="py-16 bg-gradient-to-br from-zinc-50 to-blue-50 dark:from-zinc-900 dark:to-zinc-800">
        <div class="max-w-6xl mx-auto px-6">
          <div class="text-center mb-12">
            <h2 class="text-3xl font-bold mb-4 bg-gradient-to-r from-green-900 via-blue-600 to-purple-600 dark:from-green-100 dark:via-blue-400 dark:to-purple-400 bg-clip-text text-transparent">
              相关文章
            </h2>
            <p class="text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
              探索编程开发相关的博客文章，深入了解前端工程的技术实践。
            </p>
            <div class="w-24 h-1 bg-gradient-to-r from-green-500 to-blue-500 mx-auto rounded-full mt-4" />
          </div>

          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {programmingPosts.map((post) => (
              <article class="group bg-white dark:bg-zinc-800 rounded-2xl shadow-lg hover:shadow-2xl transition-all duration-300 overflow-hidden border border-gray-100 dark:border-zinc-700">
                <div class="h-48 bg-gradient-to-br from-green-400 to-blue-500 relative overflow-hidden">
                  <div class="absolute inset-0 bg-black bg-opacity-20" />
                  <div class="absolute bottom-4 left-4 text-white">
                    <span class="text-sm opacity-90">
                      {new Date(post.data.pubDate).toLocaleDateString("zh-CN")}
                    </span>
                  </div>
                </div>
                <div class="p-6">
                  <h3 class="text-xl font-bold mb-3 group-hover:text-green-600 dark:group-hover:text-green-400 transition-colors line-clamp-2">
                    {post.data.title}
                  </h3>
                  {post.data.description && (
                    <p class="text-gray-600 dark:text-gray-400 text-sm line-clamp-3 mb-4">
                      {post.data.description}
                    </p>
                  )}
                  <a
                    href={`/blog/${post.id}`}
                    class="inline-flex items-center text-green-600 dark:text-green-400 font-medium hover:text-green-800 dark:hover:text-green-300 transition-colors"
                  >
                    阅读文章
                    <svg
                      class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M13 7l5 5m0 0l-5 5m5-5H6"
                      />
                    </svg>
                  </a>
                </div>
              </article>
            ))}
          </div>

          <div class="text-center mt-8">
            <a
              href="/blog?category=programming"
              class="inline-flex items-center px-8 py-4 bg-gradient-to-r from-green-600 to-blue-600 text-white rounded-2xl hover:from-green-700 hover:to-blue-700 transition-all duration-300 shadow-lg hover:shadow-xl"
            >
              查看更多编程文章
              <svg
                class="w-5 h-5 ml-2"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 7l5 5m0 0l-5 5m5-5H6"
                />
              </svg>
            </a>
          </div>
        </div>
      </section>
    )
  }

  <!-- Programming Quote -->
  <section class="py-16 bg-gradient-to-r from-green-600 to-blue-600">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <blockquote
        class="text-2xl md:text-3xl font-medium text-white leading-relaxed mb-6"
      >
        "代码是写给人看的，只是恰好能在机器上运行。"
      </blockquote>
      <p class="text-green-100 text-lg">— 编程哲学</p>
    </div>
  </section>
</Layout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
