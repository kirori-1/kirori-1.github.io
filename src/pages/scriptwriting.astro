---
import Layout from "../components/Layout.astro";
import { getCollection } from "astro:content";
import { categories, getCategoryById } from "../config/categories";

// 获取剧本创作相关的博客文章
const allPosts = await getCollection("blog");
const creativeCategory = getCategoryById("creative");
const creativePosts = allPosts
  .filter((post) => {
    const postTags = (post.data as any).tags || [];
    return postTags.some((tag: string) => creativeCategory?.tags.includes(tag));
  })
  .sort(
    (a, b) =>
      new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
  )
  .slice(0, 6);
---

<Layout
  title="剧本创作"
  description="剧本写作、创作技巧与故事创作实践"
  image="/logo.png"
>
  <!-- Hero Section -->
  <section
    class="relative py-20 bg-gradient-to-br from-pink-50 via-purple-50 to-indigo-50 dark:from-pink-950 dark:via-purple-900 dark:to-indigo-900"
  >
    <div
      class="absolute inset-0 bg-gradient-to-r from-pink-600/10 via-purple-600/10 to-indigo-600/10"
    >
    </div>
    <div class="relative max-w-4xl mx-auto px-6 text-center">
      <div
        class="inline-flex items-center justify-center w-20 h-20 bg-gradient-to-r from-pink-500 to-purple-600 rounded-2xl mb-6 shadow-lg"
      >
        <span class="text-3xl">📝</span>
      </div>
      <h1
        class="text-5xl font-bold mb-6 bg-gradient-to-r from-pink-900 via-purple-600 to-indigo-600 dark:from-pink-100 dark:via-purple-400 dark:to-indigo-400 bg-clip-text text-transparent"
      >
        剧本创作
      </h1>
      <p
        class="text-xl text-gray-600 dark:text-gray-400 max-w-3xl mx-auto leading-relaxed"
      >
        用文字编织故事，用对话塑造人物。这里记录了我的剧本写作实践、创作技巧与故事创作心得。
      </p>
      <div
        class="w-24 h-1 bg-gradient-to-r from-pink-500 to-purple-500 mx-auto rounded-full mt-6"
      >
      </div>
    </div>
  </section>

  <!-- Scriptwriting Overview -->
  <section class="py-16 bg-white dark:bg-zinc-900">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold mb-4 text-gray-900 dark:text-white">
          创作领域
        </h2>
        <p class="text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
          从剧本结构到人物塑造，从对话写作到情节设计，探索戏剧创作的各个层面。
        </p>
      </div>

      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        <div
          class="group bg-gradient-to-br from-pink-50 to-purple-50 dark:from-pink-900/20 dark:to-purple-900/20 p-8 rounded-2xl border border-pink-100 dark:border-pink-800 hover:shadow-xl transition-all duration-300"
        >
          <div class="text-4xl mb-4">🎭</div>
          <h3 class="text-xl font-bold mb-3 text-gray-900 dark:text-white">
            戏剧剧本
          </h3>
          <p class="text-gray-600 dark:text-gray-400">
            舞台剧、话剧剧本的创作，注重对话的戏剧性和舞台表现力。
          </p>
        </div>

        <div
          class="group bg-gradient-to-br from-purple-50 to-indigo-50 dark:from-purple-900/20 dark:to-indigo-900/20 p-8 rounded-2xl border border-purple-100 dark:border-purple-800 hover:shadow-xl transition-all duration-300"
        >
          <div class="text-4xl mb-4">🎬</div>
          <h3 class="text-xl font-bold mb-3 text-gray-900 dark:text-white">
            影视剧本
          </h3>
          <p class="text-gray-600 dark:text-gray-400">
            电影、电视剧剧本创作，注重视觉叙事和镜头语言。
          </p>
        </div>

        <div
          class="group bg-gradient-to-br from-indigo-50 to-blue-50 dark:from-indigo-900/20 dark:to-blue-900/20 p-8 rounded-2xl border border-indigo-100 dark:border-indigo-800 hover:shadow-xl transition-all duration-300"
        >
          <div class="text-4xl mb-4">📖</div>
          <h3 class="text-xl font-bold mb-3 text-gray-900 dark:text-white">
            故事创作
          </h3>
          <p class="text-gray-600 dark:text-gray-400">
            短篇小说、中篇故事创作，探索叙事技巧和文学表达。
          </p>
        </div>

        <div
          class="group bg-gradient-to-br from-blue-50 to-green-50 dark:from-blue-900/20 dark:to-green-900/20 p-8 rounded-2xl border border-blue-100 dark:border-blue-800 hover:shadow-xl transition-all duration-300"
        >
          <div class="text-4xl mb-4">👥</div>
          <h3 class="text-xl font-bold mb-3 text-gray-900 dark:text-white">
            人物塑造
          </h3>
          <p class="text-gray-600 dark:text-gray-400">
            创造立体的人物形象，通过对话和行动展现性格特征。
          </p>
        </div>

        <div
          class="group bg-gradient-to-br from-green-50 to-yellow-50 dark:from-green-900/20 dark:to-yellow-900/20 p-8 rounded-2xl border border-green-100 dark:border-green-800 hover:shadow-xl transition-all duration-300"
        >
          <div class="text-4xl mb-4">💬</div>
          <h3 class="text-xl font-bold mb-3 text-gray-900 dark:text-white">
            对话写作
          </h3>
          <p class="text-gray-600 dark:text-gray-400">
            创作自然流畅的对话，让每个角色都有独特的语言风格。
          </p>
        </div>

        <div
          class="group bg-gradient-to-br from-yellow-50 to-pink-50 dark:from-yellow-900/20 dark:to-pink-900/20 p-8 rounded-2xl border border-yellow-100 dark:border-yellow-800 hover:shadow-xl transition-all duration-300"
        >
          <div class="text-4xl mb-4">📐</div>
          <h3 class="text-xl font-bold mb-3 text-gray-900 dark:text-white">
            结构设计
          </h3>
          <p class="text-gray-600 dark:text-gray-400">
            构建完整的故事结构，掌握起承转合的叙事技巧。
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Writing Process -->
  <section
    class="py-16 bg-gradient-to-br from-gray-50 to-blue-50 dark:from-gray-900 dark:to-blue-900"
  >
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold mb-4 text-gray-900 dark:text-white">
          创作流程
        </h2>
        <p class="text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
          从灵感到成稿，探索我的剧本创作工作流程和思考过程。
        </p>
      </div>

      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-4">
        <div class="text-center">
          <div
            class="w-16 h-16 bg-gradient-to-r from-pink-500 to-purple-600 rounded-full flex items-center justify-center mx-auto mb-4"
          >
            <span class="text-white text-2xl">💡</span>
          </div>
          <h3 class="text-lg font-semibold mb-2 text-gray-900 dark:text-white">
            灵感收集
          </h3>
          <p class="text-sm text-gray-600 dark:text-gray-400">
            从日常生活中捕捉创作灵感，记录有趣的对话和情节构思。
          </p>
        </div>

        <div class="text-center">
          <div
            class="w-16 h-16 bg-gradient-to-r from-purple-500 to-indigo-600 rounded-full flex items-center justify-center mx-auto mb-4"
          >
            <span class="text-white text-2xl">📋</span>
          </div>
          <h3 class="text-lg font-semibold mb-2 text-gray-900 dark:text-white">
            大纲规划
          </h3>
          <p class="text-sm text-gray-600 dark:text-gray-400">
            制定故事大纲，确定主要情节线和人物关系的发展脉络。
          </p>
        </div>

        <div class="text-center">
          <div
            class="w-16 h-16 bg-gradient-to-r from-indigo-500 to-blue-600 rounded-full flex items-center justify-center mx-auto mb-4"
          >
            <span class="text-white text-2xl">✍️</span>
          </div>
          <h3 class="text-lg font-semibold mb-2 text-gray-900 dark:text-white">
            初稿创作
          </h3>
          <p class="text-sm text-gray-600 dark:text-gray-400">
            按照剧本格式创作初稿，注重对话的戏剧性和场景描述。
          </p>
        </div>

        <div class="text-center">
          <div
            class="w-16 h-16 bg-gradient-to-r from-blue-500 to-green-600 rounded-full flex items-center justify-center mx-auto mb-4"
          >
            <span class="text-white text-2xl">🔍</span>
          </div>
          <h3 class="text-lg font-semibold mb-2 text-gray-900 dark:text-white">
            修改完善
          </h3>
          <p class="text-sm text-gray-600 dark:text-gray-400">
            反复修改和完善，优化对话表达和情节逻辑，追求最佳效果。
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Related Blog Posts -->
  {
    creativePosts.length > 0 && (
      <section class="py-16 bg-gradient-to-br from-zinc-50 to-blue-50 dark:from-zinc-900 dark:to-zinc-800">
        <div class="max-w-6xl mx-auto px-6">
          <div class="text-center mb-12">
            <h2 class="text-3xl font-bold mb-4 bg-gradient-to-r from-pink-900 via-purple-600 to-indigo-600 dark:from-pink-100 dark:via-purple-400 dark:to-indigo-400 bg-clip-text text-transparent">
              相关文章
            </h2>
            <p class="text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
              探索剧本创作相关的博客文章，深入了解我的创作历程和技巧分享。
            </p>
            <div class="w-24 h-1 bg-gradient-to-r from-pink-500 to-purple-500 mx-auto rounded-full mt-4" />
          </div>

          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {creativePosts.map((post) => (
              <article class="group bg-white dark:bg-zinc-800 rounded-2xl shadow-lg hover:shadow-2xl transition-all duration-300 overflow-hidden border border-gray-100 dark:border-zinc-700">
                <div class="h-48 bg-gradient-to-br from-pink-400 to-purple-500 relative overflow-hidden">
                  <div class="absolute inset-0 bg-black bg-opacity-20" />
                  <div class="absolute bottom-4 left-4 text-white">
                    <span class="text-sm opacity-90">
                      {new Date(post.data.pubDate).toLocaleDateString("zh-CN")}
                    </span>
                  </div>
                </div>
                <div class="p-6">
                  <h3 class="text-xl font-bold mb-3 group-hover:text-pink-600 dark:group-hover:text-pink-400 transition-colors line-clamp-2">
                    {post.data.title}
                  </h3>
                  {post.data.description && (
                    <p class="text-gray-600 dark:text-gray-400 text-sm line-clamp-3 mb-4">
                      {post.data.description}
                    </p>
                  )}
                  <a
                    href={`/blog/${post.id}`}
                    class="inline-flex items-center text-pink-600 dark:text-pink-400 font-medium hover:text-pink-800 dark:hover:text-pink-300 transition-colors"
                  >
                    阅读文章
                    <svg
                      class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M13 7l5 5m0 0l-5 5m5-5H6"
                      />
                    </svg>
                  </a>
                </div>
              </article>
            ))}
          </div>

          <div class="text-center mt-8">
            <a
              href="/blog?category=creative"
              class="inline-flex items-center px-8 py-4 bg-gradient-to-r from-pink-600 to-purple-600 text-white rounded-2xl hover:from-pink-700 hover:to-purple-700 transition-all duration-300 shadow-lg hover:shadow-xl"
            >
              查看更多创作文章
              <svg
                class="w-5 h-5 ml-2"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 7l5 5m0 0l-5 5m5-5H6"
                />
              </svg>
            </a>
          </div>
        </div>
      </section>
    )
  }

  <!-- Creative Quote -->
  <section class="py-16 bg-gradient-to-r from-pink-600 to-purple-600">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <blockquote
        class="text-2xl md:text-3xl font-medium text-white leading-relaxed mb-6"
      >
        "创作就是发现，就是在平凡中发现非凡。"
      </blockquote>
      <p class="text-pink-100 text-lg">— 创作感悟</p>
    </div>
  </section>
</Layout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
