---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
---

<!doctype html>
<html lang="ja">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <div class="space-y-4 text-gray-800">
        <section>
          <h2 class="text-lg font-bold">🎵 提供サービス</h2>
          <ul class="list-disc list-inside">
            <li>ギターの調律（標準・特殊）</li>
            <li>宅録・編集・整音</li>
            <li>ミックス・マスタリング</li>
          </ul>
        </section>

        <section>
          <h2 class="text-lg font-bold">🛠 使用機材一覧</h2>
          <table class="table-auto border border-gray-300 mt-2">
            <thead>
              <tr class="bg-gray-100">
                <th class="border px-4 py-2">カテゴリ</th>
                <th class="border px-4 py-2">製品名</th>
              </tr>
            </thead>
            <tbody>
              <tr
                ><td class="border px-4 py-2">オーディオIF</td><td
                  class="border px-4 py-2">Scarlett 2i2 / FLOW 8</td
                ></tr
              >
              <tr
                ><td class="border px-4 py-2">マイク</td><td
                  class="border px-4 py-2">AT2035 / SM58S</td
                ></tr
              >
              <tr
                ><td class="border px-4 py-2">ギター</td><td
                  class="border px-4 py-2">Fender Japan ST-STD</td
                ></tr
              >
              <tr
                ><td class="border px-4 py-2">エフェクター</td><td
                  class="border px-4 py-2">Ampero 2</td
                ></tr
              >
              <tr
                ><td class="border px-4 py-2">電子ピアノ</td><td
                  class="border px-4 py-2">YAMAHA NP-12</td
                ></tr
              >
              <tr
                ><td class="border px-4 py-2">MIDIキーボード</td><td
                  class="border px-4 py-2">KORG microKEY Air</td
                ></tr
              >
              <tr
                ><td class="border px-4 py-2">DAW</td><td
                  class="border px-4 py-2"
                  >Ableton / Logic / Studio One / Pro Tools / Cubase / FL Studio</td
                ></tr
              >
            </tbody>
          </table>
        </section>
      </div>
      <Footer />
    </main>
  </body>
</html>
