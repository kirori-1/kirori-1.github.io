---
import Layout from "../components/Layout.astro";
import { getCollection } from "astro:content";
import { categories, getCategoryById } from "../config/categories";

// 获取工具文档相关的博客文章
const allPosts = await getCollection("blog");
const toolsCategory = getCategoryById("tools");
const toolsPosts = allPosts
  .filter((post) => {
    const postTags = (post.data as any).tags || [];
    return postTags.some((tag: string) => toolsCategory?.tags.includes(tag));
  })
  .sort(
    (a, b) =>
      new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
  )
  .slice(0, 6);
---

<Layout
  title="工具文档"
  description="开发工具、文档系统与 Markdown 使用指南"
  image="/logo.png"
>
  <!-- Hero Section -->
  <section
    class="relative py-20 bg-gradient-to-br from-yellow-50 via-orange-50 to-red-50 dark:from-yellow-950 dark:via-orange-900 dark:to-red-900"
  >
    <div
      class="absolute inset-0 bg-gradient-to-r from-yellow-600/10 via-orange-600/10 to-red-600/10"
    >
    </div>
    <div class="relative max-w-4xl mx-auto px-6 text-center">
      <div
        class="inline-flex items-center justify-center w-20 h-20 bg-gradient-to-r from-yellow-500 to-orange-600 rounded-2xl mb-6 shadow-lg"
      >
        <span class="text-3xl">📚</span>
      </div>
      <h1
        class="text-5xl font-bold mb-6 bg-gradient-to-r from-yellow-900 via-orange-600 to-red-600 dark:from-yellow-100 dark:via-orange-400 dark:to-red-400 bg-clip-text text-transparent"
      >
        工具文档
      </h1>
      <p
        class="text-xl text-gray-600 dark:text-gray-400 max-w-3xl mx-auto leading-relaxed"
      >
        探索开发工具、文档系统与 Markdown 的使用技巧，提升工作效率和文档质量。
      </p>
      <div
        class="w-24 h-1 bg-gradient-to-r from-yellow-500 to-orange-500 mx-auto rounded-full mt-6"
      >
      </div>
    </div>
  </section>

  <!-- Tools Overview -->
  <section class="py-16 bg-white dark:bg-zinc-900">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold mb-4 text-gray-900 dark:text-white">
          工具领域
        </h2>
        <p class="text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
          从文档编写到工具使用，全面提升开发效率和工作流程。
        </p>
      </div>

      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        <div
          class="group bg-gradient-to-br from-yellow-50 to-orange-50 dark:from-yellow-900/20 dark:to-orange-900/20 p-8 rounded-2xl border border-yellow-100 dark:border-yellow-800 hover:shadow-xl transition-all duration-300"
        >
          <div class="text-4xl mb-4">📝</div>
          <h3 class="text-xl font-bold mb-3 text-gray-900 dark:text-white">
            Markdown
          </h3>
          <p class="text-gray-600 dark:text-gray-400">
            Markdown 语法、扩展语法、编辑器配置等文档编写技巧。
          </p>
        </div>

        <div
          class="group bg-gradient-to-br from-orange-50 to-red-50 dark:from-orange-900/20 dark:to-red-900/20 p-8 rounded-2xl border border-orange-100 dark:border-orange-800 hover:shadow-xl transition-all duration-300"
        >
          <div class="text-4xl mb-4">📖</div>
          <h3 class="text-xl font-bold mb-3 text-gray-900 dark:text-white">
            文档系统
          </h3>
          <p class="text-gray-600 dark:text-gray-400">
            文档站点搭建、内容管理、版本控制等文档系统建设。
          </p>
        </div>

        <div
          class="group bg-gradient-to-br from-red-50 to-pink-50 dark:from-red-900/20 dark:to-pink-900/20 p-8 rounded-2xl border border-red-100 dark:border-red-800 hover:shadow-xl transition-all duration-300"
        >
          <div class="text-4xl mb-4">⚡</div>
          <h3 class="text-xl font-bold mb-3 text-gray-900 dark:text-white">
            开发工具
          </h3>
          <p class="text-gray-600 dark:text-gray-400">
            VS Code、Git、构建工具等开发环境配置与使用技巧。
          </p>
        </div>

        <div
          class="group bg-gradient-to-br from-pink-50 to-purple-50 dark:from-pink-900/20 dark:to-purple-900/20 p-8 rounded-2xl border border-pink-100 dark:border-pink-800 hover:shadow-xl transition-all duration-300"
        >
          <div class="text-4xl mb-4">🔧</div>
          <h3 class="text-xl font-bold mb-3 text-gray-900 dark:text-white">
            自动化工具
          </h3>
          <p class="text-gray-600 dark:text-gray-400">
            脚本编写、任务自动化、工作流程优化等效率提升工具。
          </p>
        </div>

        <div
          class="group bg-gradient-to-br from-purple-50 to-indigo-50 dark:from-purple-900/20 dark:to-indigo-900/20 p-8 rounded-2xl border border-purple-100 dark:border-purple-800 hover:shadow-xl transition-all duration-300"
        >
          <div class="text-4xl mb-4">🎨</div>
          <h3 class="text-xl font-bold mb-3 text-gray-900 dark:text-white">
            设计工具
          </h3>
          <p class="text-gray-600 dark:text-gray-400">
            界面设计、图标制作、原型设计等设计工具使用指南。
          </p>
        </div>

        <div
          class="group bg-gradient-to-br from-indigo-50 to-blue-50 dark:from-indigo-900/20 dark:to-blue-900/20 p-8 rounded-2xl border border-indigo-100 dark:border-indigo-800 hover:shadow-xl transition-all duration-300"
        >
          <div class="text-4xl mb-4">📊</div>
          <h3 class="text-xl font-bold mb-3 text-gray-900 dark:text-white">
            数据分析
          </h3>
          <p class="text-gray-600 dark:text-gray-400">
            数据分析工具、可视化技术、报告生成等数据处理工具。
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Tool Workflow -->
  <section
    class="py-16 bg-gradient-to-br from-gray-50 to-yellow-50 dark:from-gray-900 dark:to-yellow-900"
  >
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold mb-4 text-gray-900 dark:text-white">
          工具工作流
        </h2>
        <p class="text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
          从需求分析到文档交付，探索高效的文档创作工作流程。
        </p>
      </div>

      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-4">
        <div class="text-center">
          <div
            class="w-16 h-16 bg-gradient-to-r from-yellow-500 to-orange-600 rounded-full flex items-center justify-center mx-auto mb-4"
          >
            <span class="text-white text-2xl">📋</span>
          </div>
          <h3 class="text-lg font-semibold mb-2 text-gray-900 dark:text-white">
            需求分析
          </h3>
          <p class="text-sm text-gray-600 dark:text-gray-400">
            明确文档目标，分析读者需求，制定文档结构。
          </p>
        </div>

        <div class="text-center">
          <div
            class="w-16 h-16 bg-gradient-to-r from-orange-500 to-red-600 rounded-full flex items-center justify-center mx-auto mb-4"
          >
            <span class="text-white text-2xl">✍️</span>
          </div>
          <h3 class="text-lg font-semibold mb-2 text-gray-900 dark:text-white">
            内容创作
          </h3>
          <p class="text-sm text-gray-600 dark:text-gray-400">
            使用 Markdown 编写内容，注重可读性和结构化。
          </p>
        </div>

        <div class="text-center">
          <div
            class="w-16 h-16 bg-gradient-to-r from-red-500 to-pink-600 rounded-full flex items-center justify-center mx-auto mb-4"
          >
            <span class="text-white text-2xl">🎨</span>
          </div>
          <h3 class="text-lg font-semibold mb-2 text-gray-900 dark:text-white">
            样式优化
          </h3>
          <p class="text-sm text-gray-600 dark:text-gray-400">
            调整排版、添加图表、优化视觉效果。
          </p>
        </div>

        <div class="text-center">
          <div
            class="w-16 h-16 bg-gradient-to-r from-pink-500 to-purple-600 rounded-full flex items-center justify-center mx-auto mb-4"
          >
            <span class="text-white text-2xl">🚀</span>
          </div>
          <h3 class="text-lg font-semibold mb-2 text-gray-900 dark:text-white">
            发布维护
          </h3>
          <p class="text-sm text-gray-600 dark:text-gray-400">
            部署到平台，持续更新，收集反馈优化。
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Related Blog Posts -->
  {
    toolsPosts.length > 0 && (
      <section class="py-16 bg-gradient-to-br from-zinc-50 to-yellow-50 dark:from-zinc-900 dark:to-yellow-900">
        <div class="max-w-6xl mx-auto px-6">
          <div class="text-center mb-12">
            <h2 class="text-3xl font-bold mb-4 bg-gradient-to-r from-yellow-900 via-orange-600 to-red-600 dark:from-yellow-100 dark:via-orange-400 dark:to-red-400 bg-clip-text text-transparent">
              相关文章
            </h2>
            <p class="text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
              探索工具文档相关的博客文章，深入了解文档系统的技术实践。
            </p>
            <div class="w-24 h-1 bg-gradient-to-r from-yellow-500 to-orange-500 mx-auto rounded-full mt-4" />
          </div>

          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {toolsPosts.map((post) => (
              <article class="group bg-white dark:bg-zinc-800 rounded-2xl shadow-lg hover:shadow-2xl transition-all duration-300 overflow-hidden border border-gray-100 dark:border-zinc-700">
                <div class="h-48 bg-gradient-to-br from-yellow-400 to-orange-500 relative overflow-hidden">
                  <div class="absolute inset-0 bg-black bg-opacity-20" />
                  <div class="absolute bottom-4 left-4 text-white">
                    <span class="text-sm opacity-90">
                      {new Date(post.data.pubDate).toLocaleDateString("zh-CN")}
                    </span>
                  </div>
                </div>
                <div class="p-6">
                  <h3 class="text-xl font-bold mb-3 group-hover:text-yellow-600 dark:group-hover:text-yellow-400 transition-colors line-clamp-2">
                    {post.data.title}
                  </h3>
                  {post.data.description && (
                    <p class="text-gray-600 dark:text-gray-400 text-sm line-clamp-3 mb-4">
                      {post.data.description}
                    </p>
                  )}
                  <a
                    href={`/blog/${post.id}`}
                    class="inline-flex items-center text-yellow-600 dark:text-yellow-400 font-medium hover:text-yellow-800 dark:hover:text-yellow-300 transition-colors"
                  >
                    阅读文章
                    <svg
                      class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M13 7l5 5m0 0l-5 5m5-5H6"
                      />
                    </svg>
                  </a>
                </div>
              </article>
            ))}
          </div>

          <div class="text-center mt-8">
            <a
              href="/blog?category=tools"
              class="inline-flex items-center px-8 py-4 bg-gradient-to-r from-yellow-600 to-orange-600 text-white rounded-2xl hover:from-yellow-700 hover:to-orange-700 transition-all duration-300 shadow-lg hover:shadow-xl"
            >
              查看更多工具文章
              <svg
                class="w-5 h-5 ml-2"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 7l5 5m0 0l-5 5m5-5H6"
                />
              </svg>
            </a>
          </div>
        </div>
      </section>
    )
  }

  <!-- Tools Quote -->
  <section class="py-16 bg-gradient-to-r from-yellow-600 to-orange-600">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <blockquote
        class="text-2xl md:text-3xl font-medium text-white leading-relaxed mb-6"
      >
        "好的工具是效率的倍增器，好的文档是知识的传承者。"
      </blockquote>
      <p class="text-yellow-100 text-lg">— 工具使用感悟</p>
    </div>
  </section>
</Layout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
